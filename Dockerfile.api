FROM python:3.14-slim AS base

# Install uv from the official distroless image
COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /uvx /usr/local/bin/

ENV PYTHONUNBUFFERED=1 \
    # Use the base image's Python instead of downloading one
    UV_PYTHON_DOWNLOADS=0 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# System deps (psycopg, build tools, ffmpeg for MP3 processing)
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ffmpeg \
  && rm -rf /var/lib/apt/lists/*

# Install locked dependencies first (without the project) for better layer caching
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project --no-dev

# Copy the application and install the project itself
COPY . .
RUN uv sync --locked --no-dev

# Put the project virtualenv on PATH so python/gunicorn/alembic resolve to it
ENV PATH="/app/.venv/bin:$PATH"

# Expose API port
EXPOSE 8000

# Healthcheck hits /api/v1/health
HEALTHCHECK --interval=30s --timeout=5s --retries=5 CMD curl -fsS http://localhost:8000/api/v1/health || exit 1

# Add lightweight entrypoint that initializes DB, seeds voices, then starts the API
RUN chmod +x scripts/docker-entrypoint.sh || true
ENTRYPOINT ["sh", "scripts/docker-entrypoint.sh"]
