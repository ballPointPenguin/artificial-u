# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artificial_u_dev

# API Keys
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Configuration
LOG_LEVEL=INFO
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_PUBLIC_URL=http://localhost:9000

# FastAPI / Auth0
AUTH0_ALG=RS256
AUTH0_AUDIENCE=https://artificial-u.com/
AUTH0_DOMAIN=your-auth0-tenant.us.auth0.com

# Optional: Specify content generation models
COURSE_GENERATION_MODEL=gpt-5-nano
