# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artificial_u_dev

# API Keys
ALIBABA_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Optional second ElevenLabs account; used while the primary key's quota is exhausted
ELEVENLABS_API_KEY_ALT=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Configuration
LECTURE_IMAGE_INTERVAL_SEC=45
LECTURE_WORD_COUNT=3000
LOG_LEVEL=INFO
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_TYPE=minio
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Flags
# Set to 1 to enable process-level memory & GC telemetry
DIAG_PROCESS_METRICS=0

# FastAPI / Auth0
AUTH0_ALG=RS256
AUTH0_AUDIENCE=https://artificial-u.com/
AUTH0_DOMAIN=your-auth0-tenant.us.auth0.com

# Optional: Specify content generation models
COURSE_GENERATION_MODEL=gpt-6-luna
DEPARTMENT_GENERATION_MODEL=gpt-6-luna
LECTURE_GENERATION_MODEL=claude-sonnet-5-5
LECTURE_SUMMARY_MODEL=gpt-6-luna
PROFESSOR_GENERATION_MODEL=gpt-6-luna
TOPICS_GENERATION_MODEL=gemini-3.8-flash
IMAGE_GENERATION_MODEL=gemini-nano-banana-2.1
TTS_VOICE_MODEL=eleven_v4

# TTS backend selection: elevenlabs | mistral | xai | qwen
# tts_backend=elevenlabs
# Qwen (Alibaba Model Studio) TTS — used only when tts_backend=qwen
# qwen-audio-3.1-tts-flash is hosted only in the Singapore and Beijing regions, at a
# workspace-specific endpoint: https://{ALIBABA_WORKSPACE_ID}.{region}.maas.aliyuncs.com
# Your ALIBABA_API_KEY must be created in the same region (keys are region-locked).
# ALIBABA_WORKSPACE_ID=
# ALIBABA_TTS_REGION=ap-southeast-1
# TTS_QWEN_MODEL=qwen-audio-3.1-tts-flash

# Text Generation Models
# claude-opus-5-5
# claude-opus-5
# claude-sonnet-5-5
# claude-sonnet-5
# claude-haiku-4-5
# gemini-3.1-pro-preview
# gemini-3.8-flash
# gpt-6.1-sol
# gpt-6-sol
# gpt-6.1-terra
# gpt-6-terra
# gpt-6-luna
# gpt-5.6
# gpt-5.6-sol
# gpt-5.6-luna
# grok-4.7

# Image Generation Models
# gemini-nano-banana-2.1
# gemini-3-pro-image   # Nano Banana Pro
# gemini-3.1-flash-image # Nano Banana 2
# gemini-3.1-flash-lite-image # Nano Banana 2 Lite
# gpt-image-2
# gpt-image-2.5-flare

# Voice Models
# eleven_v4 (default; works with all library voices)
# eleven_v3
# eleven_multilingual_v2
# eleven_flash_v2_5
# eleven_flash_v2
# voxtral-mini-tts-2603
# xai (no model specified)
# qwen-audio-3.1-tts-flash
