[flake8]
max-line-length = 120
extend-ignore = E203,W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    venv,
    .venv,
    alembic,
    scripts,
    web
per-file-ignores =
    __init__.py: F401,
    alembic/env.py: E402,
    scripts/*: C901,
    tests/api/*: C901
max-complexity = 12
