OPENAI_API_KEY=test_openai_key

# Test Configuration
LOG_LEVEL=WARN

# Test-specific settings
TESTING=true

# Optional: Specify content generation models
COURSE_GENERATION_MODEL=qwen3:0.6b
DEPARTMENT_GENERATION_MODEL=qwen3:0.6b
LECTURE_GENERATION_MODEL=qwen3:0.6b
LECTURE_SUMMARY_MODEL=qwen3:0.6b
PROFESSOR_GENERATION_MODEL=qwen3:0.6b
TOPICS_GENERATION_MODEL=qwen3:0.6b
