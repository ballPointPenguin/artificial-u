# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artificial_u_test
POSTGRES_PORT=5432

# Test API Keys (these will be mocked in automated tests)
ANTHROPIC_API_KEY=test_anthropic_key
ELEVENLABS_API_KEY=test_elevenlabs_key
GOOGLE_API_KEY=test_google_key
OPENAI_API_KEY=test_openai_key
SPEECH_KEY=test_speech_key
SPEECH_REGION=test_speech_region

# Test Configuration
LOG_LEVEL=WARN

# Test-specific settings
TESTING=true

# Optional: Specify content generation models
COURSE_GENERATION_MODEL=qwen3:0.6b
DEPARTMENT_GENERATION_MODEL=qwen3:0.6b
LECTURE_GENERATION_MODEL=qwen3:0.6b
PROFESSOR_GENERATION_MODEL=qwen3:0.6b
TOPICS_GENERATION_MODEL=qwen3:0.6b
